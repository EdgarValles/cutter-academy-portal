# Copia este archivo como ".env" y ajusta los valores.

# Conexión a MongoDB. Con usuario y contraseña: mongodb://usuario:clave@servidor:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cutter_academy

# Puerto donde se abre el portal
PUERTO=3000

# Administrador que se crea SOLO en el primer arranque (contraseña de 8 caracteres o más).
# Después de entrar, cambia la contraseña en "Cuenta" y borra estas dos líneas.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

# Pon 1 cuando el portal se sirva por HTTPS (recomendado si se usa fuera de la red del gimnasio)
COOKIE_SEGURA=0
# Pon 1 si hay un proxy inverso delante (nginx, Caddy)
PROXY=0
